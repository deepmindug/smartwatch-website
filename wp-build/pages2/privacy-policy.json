ments": []}, {"id": "10e4bf5", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Founded in 2011, we provide Software-as-a-Service (SaaS) for fleet management, workshop management, and IoT smart solutions that improve safety, security, and productivity.</p>", "_css_classes": "sw-legal-p", "__globals__": {"typography_typography": "globals/typography?id=text", "text_color": "globals/colors?id=text"}}, "elements": []}, {"id": "3e39f00", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Address: Plot 7, Mundeka Road, Bugolobi, Balenzi Building, 1st Floor, P.O. Box 2359, Kampala, Uganda</p>", "_css_classes": "sw-legal-p", "__globals__": {"typography_typography": "globals/typography?id=text", "text_color": "globals/colors?id=text"}}, "elements": []}, {"id": "efd6a0b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Email: customersupport@smartwatchsolutions.com</p>", "_css_classes": "sw-legal-p", "__globals__": {"typography_typography": "globals/typography?id=text", "text_color": "globals/colors?id=text"}}, "elements": []}]}, {"id": "ccda92b", "elType": "container", "isInner": true, "settings": {"flex_direction": "column", "flex_wrap": "nowrap", "content_width": "full", "flex_gap": {"unit": "px", "size": 12, "column": "12", "row": "12", "isLinked": true}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "css_classes": "sw-legal-section"}, "elements": [{"id": "3b4ad03", "elType": "widget", "widgetType": "heading", "settings": {"title": "Your privacy", "header_size": "h2", "_css_classes": "sw-legal-h", "__globals__": {"typography_typography": "globals/typography?id=swcardh", "title_color": "globals/colors?id=swheading"}}, "elements": []}, {"id": "459526e", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>We respect your privacy and only collect the information we need to make our website work better for you.</p>", "_css_classes": "sw-legal-p", "__globals__": {"typography_typography": "globals/typography?id=text", "text_color": "globals/colors?id=text"}}, "elements": []}, {"id": "6090f13", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>We do not sell, rent, or share your personal data with third parties for marketing.</p>", "_css_classes": "sw-legal-p", "__globals__": {"typography_typography": "globals/typography?id=text", "text_color": "globals/colors?id=text"}}, "elements": []}, {"id": "136380b", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Here's what we do:</p>", "_css_classes": "sw-legal-p", "__globals__": {"typography_typography": "globals/typography?id=text", "text_color": "globals/colors?id=text"}}, "elements": []}, {"id": "1501033", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<ul><li>We collect information only by fair and lawful means.</li><li>We explain why we collect it before or when we do.</li><li>We use it only for the reason we collected it.</li><li>We keep it safe and protect it from unauthorised access.</li><li>We keep it only for as long as needed to serve you better.</li></ul>", "_css_classes": "sw-legal-bullets", "__globals__": {"typography_typography": "globals/typography?id=text", "text_color": "globals/colors?id=text"}}, "elements": []}]}, {"id": "5d301ff", "elType": "container", "isInner": true, "settings": {"flex_direction": "column", "flex_wrap": "nowrap", "content_width": "full", "flex_gap": {"unit": "px", "size": 12, "column": "12", "row": "12", "isLinked": true}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "css_classes": "sw-legal-section"}, "elements": [{"id": "be1aa27", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cookies: what they are", "header_size": "h2", "_css_classes": "sw-legal-h", "__globals__": {"typography_typography": "globals/typography?id=swcardh", "title_color": "globals/colors?id=swheading"}}, "elements": []}, {"id": "a8b405c", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Like most websites, we use cookies.</p>", "_css_classes": "sw-legal-p", "__globals__": {"typography_typography": "globals/typography?id=text", "text_color": "globals/colors?id=text"}}, "elements": []}, {"id": "3193338", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Cookies are small text files stored on your device that help the website remember your preferences and improve your browsing experience.</p>", "_css_classes": "sw-legal-p", "__globals__": {"typography_typography": "globals/typography?id=text", "text_color": "globals/colors?id=text"}}, "elements": []}, {"id": "6e6e891", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Some cookies are essential for the website to work, while others help us understand how visitors use our site.</p>", "_css_classes": "sw-legal-p", "__globals__": {"typography_typography": "globals/typography?id=text", "text_color": "globals/colors?id=text"}}, "elements": []}]}, {"id": "d117e71", "elType": "container", "isInner": true, "settings": {"flex_direction": "column", "flex_wrap": "nowrap", "content_width": "full", "flex_gap": {"unit": "px", "size": 12, "column": "12", "row": "12", "isLinked": true}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "css_classes": "sw-legal-section"}, "elements": [{"id": "a8e6dfa", "elType": "widget", "widgetType": "heading", "settings": {"title": "How we use cookies", "header_size": "h2", "_css_classes": "sw-legal-h", "__globals__": {"typography_typography": "globals/typography?id=swcardh", "title_color": "globals/colors?id=swheading"}}, "elements": []}, {"id": "6e1f127", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>These cookies help us make our website more useful and relevant to you. We use cookies to:</p>", "_css_classes": "sw-lega