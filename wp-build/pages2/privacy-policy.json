[{"id": "2f300ad", "elType": "container", "isInner": false, "settings": {"flex_direction": "column", "flex_wrap": "nowrap", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1192, "sizes": []}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "padding": {"unit": "px", "top": "88", "right": "24", "bottom": "40", "left": "24", "isLinked": false}, "css_classes": "sw-legal-hero", "padding_tablet": {"unit": "px", "top": "56", "right": "24", "bottom": "32", "left": "24", "isLinked": false}}, "elements": [{"id": "cf1c419", "elType": "container", "isInner": true, "settings": {"flex_direction": "column", "flex_wrap": "nowrap", "content_width": "full", "width": {"unit": "px", "size": 760, "sizes": []}, "flex_gap": {"unit": "px", "size": 18, "column": "18", "row": "18", "isLinked": true}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}}, "elements": [{"id": "9e0a42e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Privacy policy", "header_size": "h1", "_css_classes": "sw-h-page hero-headline", "__globals__": {"typography_typography": "globals/typography?id=swdisplay", "title_color": "globals/colors?id=secondary"}}, "elements": []}, {"id": "5962397", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Welcome to Smartwatch Solutions Ltd! Your privacy matters to us, and we're committed to keeping your information safe and secure while you use our website, www.smartwatchsolutions.com.</p>", "_css_classes": "sw-legal-intro", "__globals__": {"typography_typography": "globals/typography?id=swlead", "text_color": "globals/colors?id=text"}}, "elements": []}]}]}, {"id": "aa8406b", "elType": "container", "isInner": false, "settings": {"flex_direction": "column", "flex_wrap": "nowrap", "content_width": "boxed", "boxed_width": {"unit": "px", "size": 1192, "sizes": []}, "flex_gap": {"unit": "px", "size": 0, "column": "0", "row": "0", "isLinked": true}, "padding": {"unit": "px", "top": "0", "right": "24", "bottom": "96", "left": "24", "isLinked": false}, "css_classes": "sw-legal"}, "elements": [{"id": "806f63a", "elType": "container", "isInner": true, "settings": {"flex_direction": "column", "flex_wrap": "nowrap", "content_width": "full", "width": {"unit": "px", "size": 760, "sizes": []}, "flex_gap": {"unit": "px", "size": 14, "column": "14", "row": "14", "isLinked": true}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "width_mobile": {"unit": "%", "size": 100, "sizes": []}}, "elements": [{"id": "8cd70c8", "elType": "widget", "widgetType": "heading", "settings": {"title": "Who we are", "header_size": "h2", "_css_classes": "sw-legal-h", "__globals__": {"typography_typography": "globals/typography?id=swcardh", "title_color": "globals/colors?id=swheading"}}, "elements": []}, {"id": "04d82de", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Smartwatch Solutions Ltd is East Africa's leading provider of fleet and mobile asset management solutions.</p><p>Founded in 2011, we provide Software-as-a-Service (SaaS) for fleet management, workshop management, and IoT smart solutions that improve safety, security, and productivity.</p><p>Address: Plot 7, Mundeka Road, Bugolobi, Balenzi Building, 1st Floor, P.O. Box 2359, Kampala, Uganda</p><p>Email: customersupport@smartwatchsolutions.com</p>", "_css_classes": "sw-legal-body", "__globals__": {"typography_typography": "globals/typography?id=swbody15", "text_color": "globals/colors?id=text"}}, "elements": []}, {"id": "02b4839", "elType": "widget", "widgetType": "heading", "settings": {"title": "Your privacy", "header_size": "h2", "_css_classes": "sw-legal-h", "__globals__": {"typography_typography": "globals/typography?id=swcardh", "title_color": "globals/colors?id=swheading"}}, "elements": []}, {"id": "da09eb0", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>We respect your privacy and only collect the information we need to make our website work better for you.</p><p>We do not sell, rent, or share your personal data with third parties for marketing.</p><p>Here's what we do:</p>", "_css_classes": "sw-legal-body", "__globals__": {"typography_typography": "globals/typography?id=swbody15", "text_color": "globals/colors?id=text"}}, "elements": []}, {"id": "6e6ca3e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Cookies: what they are", "header_size": "h2", "_css_classes": "sw-legal-h", "__globals__": {"typography_typography": "globals/typography?id=swcardh", "title_color": "globals/colors?id=swheading"}}, "elements": []}, {"id": "f579814", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Like most websites, we use cookies.</p><p>Cookies are small text files stored on your device that help the website remember your preferences and improve your browsing experience.</p><p>Some cookies are essential for the website to work, while others help us understand how visitors use our site.</p>", "_css_classes": "sw-legal-body", "__globals__": {"typography_typography": "globals/typography?id=swbody15", "text_color": "globals/colors?id=text"}}, "elements": []}, {"id": "47a8b5d", "elType": "widget", "widgetType": "heading", "settings": {"title": "How we use cookies", "header_size": "h2", "_css_classes": "sw-legal-h", "__globals__": {"typography_typography": "globals/typography?id=swcardh", "title_color": "globals/colors?id=swheading"}}, "elements": []}, {"id": "4467f12", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>These cookies help us make our website more useful and relevant to you. We use cookies to:</p>", "_css_classes": "sw-legal-body", "__globals__": {"typography_typography": "globals/typography?id=swbody15", "text_color": "globals/colors?id=text"}}, "elements": []}, {"id": "ae54778", "elType": "widget", "widgetType": "heading", "settings": {"title": "Managing or turning off cookies", "header_size": "h2", "_css_classes": "sw-legal-h", "__globals__": {"typography_typography": "globals/typography?id=swcardh", "title_color": "globals/colors?id=swheading"}}, "elements": []}, {"id": "8ee5fbe", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>You can choose to accept or reject cookies through your browser settings.</p><p>If you turn them off, some parts of the site may not work properly, but you'll still be able to browse most of it.</p><p>You can learn how to manage cookies in your browser's Help section.</p>", "_css_classes": "sw-legal-body", "__globals__": {"typography_typography": "globals/typography?id=swbody15", "text_color": "globals/colors?id=text"}}, "elements": []}, {"id": "007ae1e", "elType": "widget", "widgetType": "heading", "settings": {"title": "Third-party cookies", "header_size": "h2", "_css_classes": "sw-legal-h", "__globals__": {"typography_typography": "globals/typography?id=swcardh", "title_color": "globals/colors?id=swheading"}}, "elements": []}, {"id": "63e2eb7", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>We may use trusted third-party tools like Google Analytics to understand how visitors use our website and improve our services.</p><p>These tools collect anonymous usage data, not your personal details. You can learn more at the official Google Analytics privacy page.</p>", "_css_classes": "sw-legal-body", "__globals__": {"typography_typography": "globals/typography?id=swbody15", "text_color": "globals/colors?id=text"}}, "elements": []}, {"id": "a412d66", "elType": "widget", "widgetType": "heading", "settings": {"title": "Email communication", "header_size": "h2", "_css_classes": "sw-legal-h", "__globals__": {"typography_typography": "globals/typography?id=swcardh", "title_color": "globals/colors?id=swheading"}}, "elements": []}, {"id": "9e2f0fa", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>If you sign up to receive updates or newsletters, we'll only send you information related to our services.</p><p>You can unsubscribe anytime using the link in our emails.</p>", "_css_classes": "sw-legal-body", "__globals__": {"typography_typography": "globals/typography?id=swbody15", "text_color": "globals/colors?id=text"}}, "elements": []}, {"id": "beb9b70", "elType": "widget", "widgetType": "heading", "settings": {"title": "Your rights", "header_size": "h2", "_css_classes": "sw-legal-h", "__globals__": {"typography_typography": "globals/typography?id=swcardh", "title_color": "globals/colors?id=swheading"}}, "elements": []}, {"id": "d0237d5", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>Just email us at customersupport@smartwatchsolutions.com and we'll be happy to help. You can contact us anytime to:</p>", "_css_classes": "sw-legal-body", "__globals__": {"typography_typography": "globals/typography?id=swbody15", "text_color": "globals/colors?id=text"}}, "elements": []}, {"id": "3610e12", "elType": "widget", "widgetType": "heading", "settings": {"title": "Changes to this policy", "header_size": "h2", "_css_classes": "sw-legal-h", "__globals__": {"typography_typography": "globals/typography?id=swcardh", "title_color": "globals/colors?id=swheading"}}, "elements": []}, {"id": "b82c6db", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>We may update this Cookie &amp; Privacy Policy from time to time. Any changes will be posted on this page with the updated date.</p>", "_css_classes": "sw-legal-body", "__globals__": {"typography_typography": "globals/typography?id=swbody15", "text_color": "globals/colors?id=text"}}, "elements": []}, {"id": "fac0b47", "elType": "widget", "widgetType": "heading", "settings": {"title": "Contact us", "header_size": "h2", "_css_classes": "sw-legal-h", "__globals__": {"typography_typography": "globals/typography?id=swcardh", "title_color": "globals/colors?id=swheading"}}, "elements": []}, {"id": "171d914", "elType": "widget", "widgetType": "text-editor", "settings": {"editor": "<p>If you have any questions about this policy or how we handle your data, please contact:</p><p>Smartwatch Solutions Ltd, Plot 7, Mundeka Road, Bugolobi, Balenzi Building, 1st Floor, P.O. Box 2359, Kampala, Uganda</p><p>customersupport@smartwatchsolutions.com</p>", "_css_classes": "sw-legal-body", "__globals__": {"typography_typography": "globals/typography?id=swbody15", "text_color": "globals/colors?id=text"}}, "elements": []}]}]}]